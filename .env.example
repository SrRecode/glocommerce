# Copy to .env and fill in real values. Never commit .env.
# Phase 1 needs only NODE_ENV + PORT + CLIENT_ORIGIN to boot.
# Atlas / Cloudinary values are wired in Phase 3-7.

# ---------- server ----------
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas (Phase 3). Tests use mongodb-memory-server and ignore this.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_TEST_URI=

# Auth (Phase 2)
JWT_ACCESS_SECRET=replace-with-64-char-random
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cloudinary (Phase 7)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---------- client ----------
VITE_API_BASE_URL=http://localhost:5000/api/v1
