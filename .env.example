# Copy to .env and fill in real values. Never commit .env.
# Tests use mongodb-memory-server and ignore every value below.

# ---------- server ----------
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas (Phase 3).
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority

# Auth (Phase 2). Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production; dev/test fall back to a built-in development secret.
JWT_ACCESS_SECRET=replace-with-64-char-random
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
# lax | strict | none. Defaults to "none" in production, "lax" otherwise.
COOKIE_SAME_SITE=lax

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# Cloudinary (Phase 3). Leave blank to store uploads on the local disk instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Product image uploads. Max accepted file size in bytes (default 5 MiB).
UPLOAD_MAX_BYTES=5242880

# Orders (Phase 4). Shipping is free by default. A flat fee (in minor units) is
# charged only when set; FREE_SHIPPING_THRESHOLD (0 = disabled) waives it above a subtotal.
SHIPPING_FLAT_FEE=0
FREE_SHIPPING_THRESHOLD=0

# ---------- client ----------
VITE_API_BASE_URL=http://localhost:5000/api/v1
