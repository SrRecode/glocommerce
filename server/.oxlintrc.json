{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import", "node"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": ["dist/**"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-console": "error",
    "no-underscore-dangle": ["warn", { "allow": ["_id"] }]
  }
}
